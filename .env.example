# 通义千问 OpenAI 兼容口
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Flash 型号通常拥有更低的首 token 和完整生成延迟。
MODEL_NAME=qwen3.7-flash
MODEL_PROVIDER=openai
MODEL_TEMPERATURE=0.3
# 关闭思考可减少隐藏推理耗时；需要更强推理能力时再改为 true。
ENABLE_THINKING=false

# 原生口：MODEL_PROVIDER=dashscope，并填 DASHSCOPE_API_KEY。
# 原生调用可绕过 OpenAI 兼容协议层；实际延迟收益取决于网络和服务端负载。
# DASHSCOPE_HTTP_BASE_URL=https://dashscope.aliyuncs.com/api/v1
